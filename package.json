{
  "name": "ohmybuddy",
  "version": "1.12.0",
  "description": "Self-hosted AI buddy that remembers you: personal AI agent with visible long-term memory, WeChat access and a full Pi coding-agent workspace for any browser",
  "main": "server.js",
  "private": true,
  "ohmybuddyCompatibility": {
    "piVersion": "1.5.0",
    "mcp": "native"
  },
  "scripts": {
    "postinstall": "node scripts/install-bundled-capabilities.cjs",
    "start": "node scripts/start-managed.cjs",
    "start:direct": "node server.js --direct",
    "test": "node scripts/run-tests.cjs",
    "test:browser": "node scripts/run-browser-tests.cjs",
    "check": "node scripts/check-syntax.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "pack:trial": "node scripts/package-trial.cjs",
    "pack:release": "node scripts/package-trial.cjs --release",
    "access:reset": "node scripts/access-reset.cjs"
  },
  "overrides": {
    "undici": "8.12.3",
    "brace-expansion": "5.0.12",
    "@earendil-works/pi-tui": "1.5.0",
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0"
  },
  "keywords": [
    "ai-assistant",
    "personal-assistant",
    "ai-agent",
    "self-hosted",
    "agent-memory",
    "long-term-memory",
    "coding-agent",
    "pi-coding-agent",
    "web-ui",
    "chatbot",
    "wechat",
    "mcp",
    "subagents",
    "llm",
    "pwa"
  ],
  "homepage": "https://github.com/YogurtJ/OhMyBuddy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YogurtJ/OhMyBuddy.git"
  },
  "bugs": {
    "url": "https://github.com/YogurtJ/OhMyBuddy/issues"
  },
  "author": "OhMyBuddy contributors",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@js-temporal/polyfill": "0.5.1",
    "@highlightjs/cdn-assets": "11.11.1",
    "@playwright/mcp": "0.0.84",
    "acorn": "8.18.0",
    "better-sqlite3": "13.0.3",
    "brace-expansion": "5.0.12",
    "cors": "^2.8.6",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "express": "^5.2.1",
    "https-proxy-agent": "7.0.6",
    "jiti": "2.7.0",
    "marked": "18.0.11",
    "node-fetch": "^2.7.0",
    "pdfjs-dist": "6.3.289",
    "strip-ansi": "7.2.0",
    "typebox": "1.3.27",
    "undici": "8.12.3",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "yaml": "2.8.3"
  }
}
